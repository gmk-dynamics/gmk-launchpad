import {
  AuthenticationDetails,
  CognitoUser,
  CognitoUserPool,
  type CognitoUserSession,
} from 'amazon-cognito-identity-js';
import { getCognitoConfig } from '@shared/constants/cognito.constants';

let userPool: CognitoUserPool | undefined;

const getUserPool = (): CognitoUserPool => {
  if (userPool) {
    return userPool;
  }

  const config = getCognitoConfig();

  userPool = new CognitoUserPool({
    UserPoolId: config.userPoolId,
    ClientId: config.clientId,
  });

  return userPool;
};

const signIn = (
  username: string,
  password: string,
): Promise<CognitoUserSession> => {
  return new Promise((resolve, reject) => {
    const user = new CognitoUser({
      Username: username,
      Pool: getUserPool(),
    });

    const authenticationDetails =
      new AuthenticationDetails({
        Username: username,
        Password: password,
      });

    user.authenticateUser(
      authenticationDetails,
      {
        onSuccess: (session) => {
          resolve(session);
        },

        onFailure: (error) => {
          reject(error);
        },

        newPasswordRequired: () => {
          reject(
            new Error(
              'A new password is required.',
            ),
          );
        },
      },
    );
  });
};

const signOut = (): void => {
  getUserPool()
    .getCurrentUser()
    ?.signOut();
};

const getCurrentSession =
  (): Promise<CognitoUserSession | null> => {
    const user =
      getUserPool().getCurrentUser();

    if (!user) {
      return Promise.resolve(null);
    }

    return new Promise(
      (resolve, reject) => {
        user.getSession(
          (
            error: Error | null,
            session: CognitoUserSession | null,
          ) => {
            if (error) {
              reject(error);
              return;
            }

            resolve(session);
          },
        );
      },
    );
  };

const getAccessToken =
  async (): Promise<string | null> => {
    const session =
      await getCurrentSession();

    if (!session) {
      return null;
    }

    return session
      .getAccessToken()
      .getJwtToken();
  };

const authService = {
  signIn,
  signOut,
  getCurrentSession,
  getAccessToken,
};

export default authService;